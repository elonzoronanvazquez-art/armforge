{
  "name": "ARMFORGE",
  "globIgnorePaths": [
    "**/*.spec.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 160,
        "StreamingTargetRadius": 320,
        "Gravity": 196.2
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Armforge": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Armforge": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Armforge": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}