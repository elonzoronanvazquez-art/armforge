--!strict
-- Rock definitions. A rock is a stack of three layers (shell -> mid -> core) built from chunks; hits strip
-- the shell around the point of impact, expose the mid layer, then the core, then the rock collapses.
-- To add a rock family: append a def here and list it under an island in Config/Islands. No code changes needed.

local Rocks = {}

export type RockDef = {
	id: string,
	name: string,
	family: string, -- stone | ore | crystal | magma
	island: string,
	size: string, -- small | medium | large | seal (a guardian's seal)
	encounter: string, -- Config/Creatures id imprisoned inside
	miningShare: number, -- fraction of the coins / xp paid for breaking the rock itself (the creature pays the rest)
	tier: number,
	rare: boolean,
	maxHp: number,
	resistance: number,
	coins: number,
	xp: number,
	shards: { number }?,
	respawn: number,
	weight: number,
	shape: { kind: string, radius: number, height: number, chunks: number, core: number },
	colors: { shell: Color3, mid: Color3, core: Color3, glow: Color3 },
	materials: { shell: Enum.Material, mid: Enum.Material, core: Enum.Material },
	glowCore: boolean,
	sound: string,
	blurb: string,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

