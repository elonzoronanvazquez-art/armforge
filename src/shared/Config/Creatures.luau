--!strict
-- Creature definitions: the enemies imprisoned inside rocks, and each island's guardian. Pure data; the combat rules live in
-- Logic/CreatureSim and the glue in server/Services/EncounterService. To add a creature: append a def here, point a rock's
-- `encounter` (Config/Rocks) at it, and pick (or add) a body template in server/World/CreatureBuilder. No service changes.
--
-- Health is a design statement: `fight` names the arm (and upgrade level) a player is expected to bring and the seconds of
-- full-uptime punching the fight is worth, so health follows the arm-power economy (Logic/CreatureStats). Rewards are multiples
-- of the reference rock's coins / xp (`coinsMult`, `xpMult`).
--
-- Mechanics (all optional, all server-authoritative):
--   armor   basic strikes only deal `mult` damage until one of `breakers` (a skill id) hits it; then it is open for
--           `breakDuration` seconds. This is what makes a learned skill matter for that creature.
--   core    while the core is exposed (after an `exposesCore` attack, or after a stagger) every strike deals `mult` x. The core
--           sits under the armor: an armored creature only takes the core bonus once its armor has been broken.
--   attacks windup (telegraph) -> strike -> recover. `interruptible` attacks are cancelled (and the creature staggers) by a
--           skill listed in `interrupters`.
--   phases  bosses: below each `hpBelow` fraction the creature pauses briefly and gains the listed changes.

local Creatures = {}

export type Attack = {
	id: string,
	name: string,
	kind: string, -- circle | cone | line
	aim: string, -- target (area locked on the player's position at wind-up start) | self (centred on the creature)
	windup: number, -- seconds of visible telegraph before the strike lands
	recover: number, -- seconds the creature is committed afterwards
	range: number, -- may start while the target is within this many studs
	cooldown: number,
	damage: number, -- health removed from a player caught in the area
	radius: number?, -- circle
	length: number?, -- cone / line
	width: number?, -- line
	halfAngle: number?, -- cone, degrees
	dash: boolean?, -- line: the creature travels along it
	interruptible: boolean?,
	exposesCore: boolean?,
	weight: number?,
	minPhase: number?,
	maxPhase: number?,
	text: string, -- one-line tell shown to the player
}

export type Phase = {
	hpBelow: number,
	name: string,
	speedMult: number?,
	windupMult: number?, -- <1 = faster telegraphs
	damageMult: number?,
	text: string,
}

export type CreatureDef = {
	id: string,
	name: string,
	title: string,
	archetype: string, -- body template: crawler | brute | shard | titan
	island: string,
	tier: string, -- normal | elite | boss
	rarity: string,
	family: string, -- feeds Combat.resolveHit trait checks (stone | ore | crystal | magma | metal)
	blurb: string,
	scale: number,
	radius: number, -- studs: reach and area checks
	height: number,
	fight: { arm: string, level: number, seconds: number }, -- health = that arm's dps x seconds (Logic/CreatureStats)
	refRock: string?, -- rock whose coins / xp the rewards are multiples of (default: the containing rock)
	resistance: number,
	speed: number,
	preferredRange: number?, -- ranged creatures keep this distance
	aggroRange: number,
	leash: number,
	emerge: number, -- seconds of the reveal during which it cannot be hurt
	staggerTime: number,
	armor: { mult: number, breakDuration: number, breakers: { string } }?,
	core: { mult: number }?,
	interrupters: { string }?,
	attacks: { Attack },
	phases: { Phase }?,
	reward: { coinsMult: number, xpMult: number, shards: number },
	repeatMult: number?, -- guardians: reward multiplier after the first victory
	recommended: { level: number, skills: { string }, text: string },
	visual: { body: Color3, plate: Color3, glow: Color3, material: Enum.Material, mesh: string?, meshYaw: number?, meshLimbs: boolean?, rig: string? },
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

