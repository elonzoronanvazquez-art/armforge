--!strict
-- Procedural attack animation data. ARMFORGE ships NO uploaded animation assets: attacks are keyframed poses
-- applied to the character's joints at runtime (client/Controllers/ArmAnimator, evaluated by Logic/PoseMath).
--
-- Pose values are Euler degrees added on top of whatever the default animation is doing:
--   Root, Waist, Neck       rotation of that joint (Waist +Y turns left, +X leans back)
--   RootPos                 translation of the Root joint in studs (weight transfer: -Z is forward)
--   RShoulder, LShoulder    +X raises the arm forward, +Z swings the right arm outward (left: -Z)
--   RElbow, LElbow          +X curls the forearm up when the arm points forward
--   RHip, LHip              +X swings the thigh forward (a step, a knee lift); +Z swings it outward
--   RKnee, LKnee            -X bends the knee (crouch, lunge, stomp wind-up)
-- Times are normalised 0..1 across `duration`. `contact` is the moment of impact: the server applies damage
-- exactly then, so the visible hit and the mechanical hit are one event (see Logic/Attack).

local Animations = {}

export type Pose = { [string]: Vector3 }
export type Key = { t: number, pose: Pose, ease: string? }
export type Move = {
	name: string,
	duration: number,
	contact: number,
	keys: { Key },
	hand: string, -- "R" | "L" | "B"
	shake: number, -- camera shake 0..1 at contact
	hitstop: number, -- seconds of freeze at contact on the attacker
	power: number, -- visual weight multiplier for impact effects 0..2
	trail: boolean,
	finisher: boolean?,
}

local V = Vector3.new

local Moves: { [string]: Move } = {}

