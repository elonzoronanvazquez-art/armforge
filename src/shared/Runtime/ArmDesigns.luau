--!strict
-- Visual recipes for every arm set: lists of pieces attached to the three R15 limb parts of the RIGHT arm (the left arm
-- is generated by mirroring). Offsets are in limb-local space: the limb hangs along Y, the elbow/wrist end is -Y,
-- +X is outward. Pieces can be gated by upgrade `tier` (0..3) so upgrades visibly improve an arm.
--
--   kind   Block | Ball | Cylinder (axis along Y after the built-in rotation) | Wedge | Mesh (AI-generated, see mesh=)
--   slot   primary | secondary | glow | dark   (colours come from the equipped palette/finish)
--   neon   true = Neon material (glows; scaled by the glow cosmetic)
--   mesh   key into Config/Assets.Meshes: an AI-generated MeshPart sized to `size`
--   fallback  primitive stand-in that is only built if the AI mesh for the design cannot be loaded
--
-- Silhouette language: Starter = wrapped leather, Stonebreaker = stacked slabs, Alloy = hydraulic steel, Crystal = grown
-- prisms, Magma = basalt over a furnace, Void = sleek black with orbiting shards.
-- To add an arm design, add an entry to Designs and an Effects entry; see docs/ADDING_CONTENT.md.

local ArmDesigns = {}

export type Piece = {
	kind: string,
	limb: string, -- UpperArm | LowerArm | Hand
	size: Vector3,
	cf: CFrame,
	slot: string,
	neon: boolean?,
	tier: number?,
	mesh: string?,
	glass: boolean?,
	fallback: boolean?,
}

local CF = CFrame.new
local ANG = CFrame.Angles
local V = Vector3.new
local PI = math.pi

local function piece(kind: string, limb: string, size: Vector3, cf: CFrame, slot: string, extra: { [string]: any }?): Piece
	local p: any = { kind = kind, limb = limb, size = size, cf = cf, slot = slot }
	if extra then
		for k, v in extra do
			p[k] = v
		end
	end
	return p
end

-- A cylinder whose axis runs along the limb: length along Y, then diameter.
local function sleeve(limb: string, y: number, length: number, dia: number, slot: string, extra: { [string]: any }?): Piece
	return piece("Cylinder", limb, V(length, dia, dia), CF(0, y, 0) * ANG(0, 0, PI / 2), slot, extra)
end

-- A thin ring around the limb.
local function ring(limb: string, y: number, dia: number, thick: number, slot: string, extra: { [string]: any }?): Piece
	return sleeve(limb, y, thick, dia, slot, extra)
end

local function ball(limb: string, pos: Vector3, dia: number, slot: string, extra: { [string]: any }?): Piece
	return piece("Ball", limb, V(dia, dia, dia), CF(pos), slot, extra)
end

local FLIP = ANG(0, 0, PI) -- AI gauntlets are modelled fingers-up; the arm hangs fingers-down

ArmDesigns.Designs = {} :: { [string]: { Piece } }

