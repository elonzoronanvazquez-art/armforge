-- True when the design includes an AI mesh piece (its primitive stand-ins are then skipped).
function ArmDesigns.hasMesh(armId: string): boolean
	local design = ArmDesigns.Designs[armId]
	if not design then
		return false
	end
	for _, p in design do
		if p.kind == "Mesh" then
			return true
		end
	end
	return false
end

