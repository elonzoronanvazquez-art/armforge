-- Small utilities: validation of untrusted remote arguments, formatting, signals.
return function(t, u)
	local Validate = u:load("Util/Validate")
	local Format = u:load("Util/Format")
	local Signal = u:load("Util/Signal")

	t.test("Validate.number rejects NaN, infinity, wrong types and out-of-range values", function()
		t.eq(Validate.number(5), 5)
		t.eq(Validate.number(0 / 0), nil)
		t.eq(Validate.number(math.huge), nil)
		t.eq(Validate.number(-math.huge), nil)
		t.eq(Validate.number("5"), nil)
		t.eq(Validate.number(nil), nil)
		t.eq(Validate.number({}), nil)
		t.eq(Validate.number(11, 0, 10), nil)
		t.eq(Validate.number(-1, 0, 10), nil)
		t.eq(Validate.number(10, 0, 10), 10)
	end)

	t.test("Validate.int only accepts whole numbers", function()
		t.eq(Validate.int(3), 3)
		t.eq(Validate.int(3.5), nil)
		t.eq(Validate.int(-2, 0), nil)
	end)

	t.test("Validate.id only accepts short alphanumeric ids", function()
		t.eq(Validate.id("Stonebreaker"), "Stonebreaker")
		t.eq(Validate.id("Fire_Ball2"), "Fire_Ball2")
		t.eq(Validate.id("../../etc"), nil)
		t.eq(Validate.id("a b"), nil)
		t.eq(Validate.id(""), nil)
		t.eq(Validate.id(string.rep("a", 40)), nil)
		t.eq(Validate.id(12), nil)
		t.eq(Validate.id({}), nil)
	end)

	t.test("Validate.string / bool / table", function()
		t.eq(Validate.string("abc", 3), "abc")
		t.eq(Validate.string("abcd", 3), nil)
		t.eq(Validate.bool(true), true)
		t.eq(Validate.bool("true"), nil)
		t.truthy(Validate.table({}))
		t.eq(Validate.table("x"), nil)
	end)

	t.test("Format.commas / compact / clock / percent", function()
		t.eq(Format.commas(1234567), "1,234,567")
		t.eq(Format.commas(12), "12")
		t.eq(Format.commas(1000), "1,000")
		t.eq(Format.compact(950), "950")
		t.eq(Format.compact(12345), "12.3K")
		t.eq(Format.compact(4.2e6), "4.2M")
		t.eq(Format.compact(3e9), "3.0B")
		t.eq(Format.clock(75), "1:15")
		t.eq(Format.clock(3700), "1:01:40")
		t.eq(Format.clock(-5), "0:00")
		t.eq(Format.percent(0.256, 1), "25.6%")
		t.eq(Format.percent(0.05), "5%")
	end)

	t.test("Signal delivers to connected handlers and stops after Disconnect", function()
		local s = Signal.new()
		local got = {}
		local c1 = s:connect(function(v)
			table.insert(got, v)
		end)
		s:fire(1)
		c1:Disconnect()
		s:fire(2)
		-- handlers run via task.spawn; in the test runtime that is synchronous enough for the first fire
		t.truthy(#got <= 1)
	end)
end
